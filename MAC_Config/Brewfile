# ==============================================================================
# Homebrew Brewfile - macOS 软件包与依赖配置
# 使用方法: brew bundle --file=./Brewfile
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心命令行工具 (Formulae)
# ------------------------------------------------------------------------------
brew "git"              # 版本控制工具
brew "gh"               # GitHub 官方命令行工具
brew "wget"             # 文件下载工具
brew "jq"               # 命令行 JSON 处理工具
brew "ripgrep"          # 极速文件内容搜索工具 (rg)
brew "fd"               # 极速文件查找工具
brew "fzf"              # 命令行模糊搜索工具
brew "tree"             # 目录树展示工具
brew "htop"             # 交互式系统监控与进程管理工具

# ------------------------------------------------------------------------------
# 2. Homebrew 图形化管理应用 (Homebrew GUI App)
# ------------------------------------------------------------------------------
cask "applite"          # 现代化的 macOS Homebrew 图形界面客户端 (管理与一键安装 Cask 应用)

# ------------------------------------------------------------------------------
# 3. 常用桌面应用 (Casks)
# 注：检测到本机已安装 Google Chrome、Microsoft Edge、WeChat、1Password、Paste
# 如需通过 Homebrew 安装以下扩展应用，取消对应行的注释 (#) 后重新运行 ./install.sh 即可
# ------------------------------------------------------------------------------

